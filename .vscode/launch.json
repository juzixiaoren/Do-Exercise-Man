{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current cpp",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\.vscode\\bin\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "preLaunchTask": "build current cpp"
        },
        {
            "name": "Debug Current Go File",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${fileDirname}\\__debug_bin.exe",
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "preLaunchTask": "go: build current file debug"
        }
    ]
}